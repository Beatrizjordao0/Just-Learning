# tela2.kv
<Tela2>:
    name: 'tela2'
    BoxLayout:
        orientation: 'vertical'
        MDLabel:
            text: 'Esta é a Tela 2'
            halign: 'center'
        MDRaisedButton:
            text: 'Ir para a Tela 1'
            pos_hint: {'center_x':0.5, 'center_y':0.4}
            on_release: app.trocar_tela('tela1')
